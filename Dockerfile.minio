# Build MinIO from a fixed upstream release because the former public image is unavailable.
FROM golang:1.24.2-alpine AS builder
RUN CGO_ENABLED=0 go install github.com/minio/minio@RELEASE.2025-04-22T22-12-26Z

FROM alpine:3.21
RUN apk add --no-cache ca-certificates && adduser -D -u 1000 minio \
    && mkdir -p /data && chown minio:minio /data
COPY --from=builder /go/bin/minio /usr/local/bin/minio
USER minio
EXPOSE 9000 9001
ENTRYPOINT ["minio"]
